# Cloudflare Pages Direct Deployment Configuration
# ------------------------------------------------

# Cloudflare Account ID: 32 hexadecimal characters (dash.cloudflare.com -> Overview)
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef

# Cloudflare API Token: ~40-50 characters with Account.Cloudflare Pages: Edit
CLOUDFLARE_API_TOKEN=cfat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target Cloudflare Pages Project Name
CLOUDFLARE_PROJECT_NAME=random-pages-vault

# Application Master Key for at-rest encryption: 64 hexadecimal characters (32 bytes)
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Daily upload cap and monthly build monitoring limit
DAILY_FREE_LIMIT=100
MONTHLY_BUILD_LIMIT=500

# Default URL style: 'branch' (subdomain) or 'path' (subdirectory)
DEFAULT_DEPLOY_MODE=branch

# Server Host binding (defaults to 127.0.0.1 for local isolation) and Port
HOST=127.0.0.1
PORT=3000
