# Cloudflare Pages CLI Workflow Configuration
# ---------------------------------------------

# 1. Cloudflare Credentials (Optional for local testing / Required for live deployments)
# Get your Account ID from Cloudflare Dashboard (Sidebar -> Overview -> Account ID)
CLOUDFLARE_ACCOUNT_ID=

# Create an API Token at https://dash.cloudflare.com/profile/api-tokens
# Permissions needed:
# - Account.Cloudflare Pages: Edit
# - User.Memberships: Read
CLOUDFLARE_API_TOKEN=

# 2. Cloudflare Pages Project Name
# If the project doesn't exist, the workflow will offer to auto-create it
CLOUDFLARE_PROJECT_NAME=random-pages-vault

# 3. Free Tier Limits & Safety Guards
# Cloudflare Pages Free Plan allows:
# - Unlimited direct upload deployments (safe practice: 100/day direct uploads)
# - 500 Git builds / month (if Git linked)
# - 100,000 Workers/Functions requests / day
DAILY_FREE_LIMIT=100
MONTHLY_BUILD_LIMIT=500

# 4. Deployment Mode: "branch" (subdomain per random link: https://<random>.<project>.pages.dev)
# or "path" (https://<project>.pages.dev/r/<random>)
DEFAULT_DEPLOY_MODE=branch

# 5. Local Dashboard Server Port
PORT=3000
