{
  "name": "cf-pages-random-workflow",
  "version": "1.0.0",
  "description": "Cloudflare Pages CLI Workflow to generate live static pages with random links and daily free limit auto-updating dashboard",
  "main": "server/server.js",
  "bin": {
    "cf-random-pages": "./cli/cli.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node scripts/start-runner.js",
    "dev": "node --watch server/server.js",
    "lint": "node scripts/lint.js",
    "typecheck": "node scripts/lint.js",
    "deploy:random": "node cli/cli.js --deploy",
    "deploy:preview": "node cli/cli.js --dry-run",
    "status": "node cli/cli.js --status",
    "reset:device": "node scripts/reset-device.js",
    "test": "node tests/security_regression.test.js && node tests/new_features.test.js && node tests/cloudflare_wizard.test.js && node tests/e2e.test.js",
    "test:security": "node tests/security_regression.test.js",
    "test:features": "node tests/new_features.test.js",
    "test:wizard": "node tests/cloudflare_wizard.test.js",
    "test:e2e": "node tests/e2e.test.js",
    "cf:login": "npx wrangler login",
    "cf:whoami": "npx wrangler whoami",
    "cf:projects": "npx wrangler pages project list"
  },
  "keywords": [
    "cloudflare",
    "pages",
    "wrangler",
    "static-pages",
    "random-links",
    "free-tier",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1",
    "wrangler": "^4.153.0"
  }
}
